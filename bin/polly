#!/bin/sh
# polly — stamp the workflow structure into a project.
#   polly <name> [parent-dir]   new project at <parent-dir>/<name> (default: current dir)
#   polly adopt [dir]           add missing structure to an existing repo, never overwrite
set -eu

usage() {
  cat <<'EOF'
Usage:
  polly <name> [parent-dir]   Create <parent-dir>/<name> from the template, git init, first commit
  polly adopt [dir]           Add the structure to an existing repo, never overwrite
  polly -h | --help           Show this help
EOF
}

die() { printf 'polly: %s\n' "$1" >&2; exit 1; }

# Resolve this script through symlinks (it is linked into ~/.local/bin) to find the repo.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
repo=$(cd "$(dirname "$self")/.." && pwd)
template=$repo/template
[ -d "$template" ] || die "template not found at $template"

new_project() {
  name=$1
  parent=${2:-.}

  case $name in
    -*|.*|*/*) die "invalid name '$name' (no leading - or ., no /)" ;;
  esac
  printf '%s' "$name" | grep -Eq '^[A-Za-z0-9._-]+$' \
    || die "invalid name '$name' (use letters, digits, . _ -)"

  [ -d "$parent" ] || die "parent dir '$parent' does not exist"
  target=$(cd "$parent" && pwd)/$name
  [ -e "$target" ] && die "'$target' already exists"

  mkdir "$target"
  cp -R "$template/." "$target/"
  sed -i '' "s/{{name}}/$name/g" "$target/CLAUDE.md"

  (
    cd "$target"
    git init -q -b main
    git add -A
    if ! git commit -q -m "Initial structure from polly"; then
      printf 'polly: files created, but the first commit failed (check git user.name/user.email)\n' >&2
    fi
  )

  printf 'Created %s\n' "$target"
  printf 'Next: cd %s && claude, then run /brief\n' "$target"
}

adopt_project() {
  dir=${1:-.}
  [ -d "$dir" ] || die "dir '$dir' does not exist"
  target=$(cd "$dir" && pwd)
  git -C "$target" rev-parse --git-dir >/dev/null 2>&1 || die "'$target' is not a git repo"
  if [ -f "$target/.polly" ]; then
    printf '%s is already a polly project\n' "$target"
    return 0
  fi

  # An existing knowledge/ keeps its own layout: don't add empty polly folders next to it.
  keep_knowledge=0
  [ -e "$target/knowledge" ] && keep_knowledge=1

  (cd "$template" && find . -type f ! -name .polly | sort) | while IFS= read -r f; do
    f=${f#./}
    case $f in
      knowledge/*/.gitkeep) [ "$keep_knowledge" = 1 ] && continue ;;
    esac
    dest=$target/$f
    if [ -e "$dest" ]; then
      printf '  skipped (exists)  %s\n' "$f"
    else
      mkdir -p "$(dirname "$dest")"
      cp "$template/$f" "$dest"
      [ "$f" = CLAUDE.md ] && sed -i '' "s/{{name}}/$(basename "$target")/g" "$dest"
      printf '  added             %s\n' "$f"
    fi
  done

  if [ -f "$target/.gitignore" ] && ! grep -Eq '^\.env' "$target/.gitignore"; then
    printf 'polly: warning: .gitignore does not ignore .env\n' >&2
  fi

  cp "$template/.polly" "$target/.polly"
  printf '  added             .polly\n'
  git -C "$target" status --short
  printf 'Nothing committed. Next: cd %s && claude, then run /onboard\n' "$target"
}

[ $# -ge 1 ] || { usage >&2; exit 1; }

case $1 in
  -h|--help) usage ;;
  adopt)
    [ $# -le 2 ] || { usage >&2; exit 1; }
    shift
    adopt_project "$@"
    ;;
  *)
    [ $# -le 2 ] || { usage >&2; exit 1; }
    new_project "$@"
    ;;
esac
